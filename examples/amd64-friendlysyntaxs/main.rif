; Full AMD64 bare-metal target with a friendly input vocabulary.
; amd64_*.rif carries the raw profile; the friendly files add readable aliases.

@block config:
    format section ".section"
    section text "rx"
    section data "rw"
    section bss "rw"
    format section_end ":"
    entry text "_start"
    comment ";"
    format label_end ":"
    default text
    word_size 64
    address_size 64
    byte_order "little"
    case_sensitive true
    symbol_prefix "_"
    local_prefix "."
    undefined_symbols "error"
    duplicate_symbols "error"
    strict true
    allow_empty_sections false
    bit_order "msb"
@end

@block linker:
    extension ".mir"
    search_path ""
@end

@LOAD "friendly_registers.rif"
@LOAD "amd64_registers.rif"
@LOAD "friendly_rules.rif"
@LOAD "amd64_instructions.rif"
@LOAD "amd64_encoding.rif"
@LOAD "amd64_arithmetic.rif"
@LOAD "amd64_memory.rif"
@LOAD "amd64_control.rif"
@LOAD "amd64_conditions.rif"
@LOAD "amd64_width32.rif"
@LOAD "amd64_width16.rif"
@LOAD "amd64_width8.rif"
@LOAD "amd64_addressing.rif"
@LOAD "amd64_branches.rif"
@LOAD "amd64_integer.rif"
@LOAD "amd64_prefixes.rif"
@LOAD "amd64_relocations.rif"

@block isa_scope:
    profile "amd64-friendly-base-integer"
    address_size "64-bit-default"
    mmx "excluded"
    sse "excluded"
    avx "excluded"
    avx512 "excluded"
    x87 "excluded"
    system "excluded"
    os_abi "none"
@end
