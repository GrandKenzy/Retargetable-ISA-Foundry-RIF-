; Prefix families deliberately exposed by this target profile.

; 0x67 address-size override with the existing 64-bit operand size. The
; 32-bit address registers reuse the canonical dst32 table from registers.rif.
@rule encode_rex_addr32_mem:
. bits 4 4
. bits 1 1
. bits $movdst.hi 1
. bits 0 1
. bits $dst32.hi 1

@rule encode_modrm_addr32_mem:
. bits 2 2
. bits $movdst.lo 3
. bits 4 3
. bits 0 2
. bits 4 3
. bits $dst32.lo 3

@rule load64_67:
. IDENT
. $movdst.name, IDENT
. COMMA
. $dst32.name, IDENT
. COMMA
. bits 103 8
. JUMP encode_rex_addr32_mem
. bits 139 8
. JUMP encode_modrm_addr32_mem
. fit_signed_exact 32

@rule store64_67:
. IDENT
. $movdst.name, IDENT
. COMMA
. $dst32.name, IDENT
. COMMA
. bits 103 8
. JUMP encode_rex_addr32_mem
. bits 137 8
. JUMP encode_modrm_addr32_mem
. fit_signed_exact 32

; LOCK is only declared for read-modify-write memory forms in this profile.
@rule encode_rex_lock_mem:
. bits 4 4
. bits 1 1
. bits $movsrc.hi 1
. bits 0 1
. bits $membase.hi 1

@rule lock_add64:
. IDENT
. $movsrc.name, IDENT
. COMMA
. $membase.name, IDENT
. COMMA
. bits 240 8
. JUMP encode_rex_lock_mem
. bits 1 8
. bits 2 2
. bits $movsrc.lo 3
. bits 4 3
. JUMP encode_sib
. fit_signed_exact 32

@rule lock_inc64:
. IDENT
. $membase.name, IDENT
. COMMA
. bits 240 8
. bits 4 4
. bits 1 1
. bits 0 2
. bits $membase.hi 1
. bits 255 8
. bits 2 2
. bits 0 3
. bits 4 3
. JUMP encode_sib
. fit_signed_exact 32

; REP string forms. The consumer initializes RSI/RDI/RCX as required by the
; selected MIR program; these Rules only declare the emitted bytes.
@rule rep_movsb:
. IDENT
. bits 243 8
. bits 164 8

@rule rep_movsq:
. IDENT
. bits 243 8
. bits 72 8
. bits 165 8

@rule rep_stosb:
. IDENT
. bits 243 8
. bits 170 8

@rule rep_stosq:
. IDENT
. bits 243 8
. bits 72 8
. bits 171 8

; FS and GS segment overrides are explicit prefix families. Other segment
; overrides are intentionally outside this bare-metal profile.
@rule fs_load64:
. IDENT
. $movdst.name, IDENT
. COMMA
. $membase.name, IDENT
. COMMA
. bits 100 8
. JUMP encode_rex_w_mem
. bits 139 8
. JUMP encode_modrm_mem
. fit_signed_exact 32

@rule gs_store64:
. IDENT
. $movdst.name, IDENT
. COMMA
. $membase.name, IDENT
. COMMA
. bits 101 8
. JUMP encode_rex_w_mem
. bits 137 8
. JUMP encode_modrm_mem
. fit_signed_exact 32
