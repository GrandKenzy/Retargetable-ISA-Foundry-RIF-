; Relatives are signed offsets from the end of the instruction.
; Caller provides the offset; labels/fixups are NOT supported here.
@rule jmp32:
. IDENT
. bits 233 8
. fit 32

@rule je32:
. IDENT
. bits 15 8
. bits 132 8
. fit 32

@rule jne32:
. IDENT
. bits 15 8
. bits 133 8
. fit 32

@rule call32:
. IDENT
. bits 232 8
. fit 32

@rule push64:
. IDENT
. $stackreg.name, IDENT
. JUMP encode_rex_stack
. bits $stackreg.pushop 8

@rule pop64:
. IDENT
. $stackreg.name, IDENT
. JUMP encode_rex_stack
. bits $stackreg.popop 8
