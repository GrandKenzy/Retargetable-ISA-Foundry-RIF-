; Raw AMD64 instruction-family fixture. It has no headers or host calls.
_start
mov rax, 41
addri rax, 1
subri rax, 0
shlri rax, 1
shrri rax, 1
xorri rax, 0
orri rax, 0
andri rax, 255
cmpri rax, 42
push64 rax
pop64 rbx
leax64 r9, rsp, rbx, 2, 16
loadx64 r10, rsp, rbx, 4, 32
storex64 r10, r12, r13, 8, 40
ret

