; Dynamic symbol definitions and relocations on AMD64 Linux.
; A reserve captures the exact relocation slot; native FIXUP resolves it after
; all MIR lines have emitted their symbols.
; mark and PC32 fixups are native; the remaining relocation families still use
; the legacy Python experiment below.

; mark NAME: defines a symbol at the current virtual byte address.
@rule mark:
. IDENT
. mark
. IDENT

; jmp_label NAME: JMP rel32, valid for both forward and backward labels.
@rule jmp_label:
. IDENT
. bits 233 8
. reserve "fix32" 32
. fixup pc32 "fix32"
. drop_res "fix32"
. IDENT

@rule call_label:
. IDENT
. bits 232 8
. reserve "fix32" 32
. fixup pc32 "fix32"
. drop_res "fix32"
. IDENT

; jcc_label CONDITION, NAME: one family for all 16 conditions.
@rule jcc_label:
. IDENT
. $conditions.name, IDENT
. COMMA
. bits 15 8
. bits $conditions.jopcode 8
. reserve "fix32" 32
. fixup pc32 "fix32"
. drop_res "fix32"
. IDENT

; RIP-relative variants: REG is destination for LOAD/LEA and source for STORE.
@rule encode_rex_rip:
. bits 4 4
. bits 1 1
. bits $movdst.hi 1
. bits 0 2

@rule encode_modrm_rip:
. bits 0 2
. bits $movdst.lo 3
. bits 5 3

@rule loadrip64:
. IDENT
. $movdst.name, IDENT
. COMMA
. JUMP encode_rex_rip
. bits 139 8
. JUMP encode_modrm_rip
. reserve "fix32" 32
. fixup pc32 "fix32"
. drop_res "fix32"
. IDENT

@rule storerip64:
. IDENT
. $movdst.name, IDENT
. COMMA
. JUMP encode_rex_rip
. bits 137 8
. JUMP encode_modrm_rip
. reserve "fix32" 32
. fixup pc32 "fix32"
. drop_res "fix32"
. IDENT

@rule learip64:
. IDENT
. $movdst.name, IDENT
. COMMA
. JUMP encode_rex_rip
. bits 141 8
. JUMP encode_modrm_rip
. reserve "fix32" 32
. fixup pc32 "fix32"
. drop_res "fix32"
. IDENT

; MOV r64, imm64 with virtual address of named symbol (absolute relocation).
@rule movaddr64:
. IDENT
. $registers.name, IDENT
. COMMA
. bits $registers.rex 8
. bits $registers.opcode 8
. reserve "fix64" 64
. fixup abs64 "fix64"
. drop_res "fix64"
. IDENT

; Emit a pointer to a symbol directly (e.g., a jump table element).
@rule dqaddr:
. IDENT
. reserve "fix64" 64
. fixup abs64 "fix64"
. drop_res "fix64"
. IDENT

; REL8 byte branch (signed), resolved after all labels.
@rule jmp8_label:
. IDENT
. bits 235 8
. reserve "fix8" 8
. fixup pc8 "fix8"
. drop_res "fix8"
. IDENT

; A virtual reservation, no physical bytes; use in a non-executable sample.
@rule virtual_scratch:
. IDENT
. vreserve "scratch" 256

; One byte from an 8-bit immediate (for literal tables in .text).
@rule db:
. IDENT
. fit_exact 8

@rule dq:
. IDENT
. fit_exact 64

; Reserving and filling fixed data in RIF without external code.
@rule reserve_and_fill_demo:
. IDENT
. reserve "slot_demo" 16
. write_res "slot_demo" "1010101111001101"
. drop_res "slot_demo"

; Native section selectors persist across MIR lines.
@rule use_text:
. IDENT
. section "text"

@rule use_data:
. IDENT
. section "data"

; Reservation metadata: stores the VIRTUAL bit position of this physical slot.
; Note: resvdir is bit-relative within the selected section, not an ELF VA.
@rule reserve_position_demo:
. IDENT
. reserve "position_slot" 64
. write_res "position_slot" resvdir "position_slot"
. drop_res "position_slot"
