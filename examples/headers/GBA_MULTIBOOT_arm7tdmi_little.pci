
; GBA Multiboot (Link Cable / Joybus)
; ARM7TDMI - Little Endian
; RIF PCP-I v1
;
; Load base: 0x02000000 (EWRAM)
; Header size: 0xE8 (232 bytes)
; ARM code starts at 0x020000E8
;
; Pits are aligned to 8 bytes.
; Checksum must be recalculated when fields change.

MAGIC "pcpi"
VERSION 1
ENDIANNESS 1
BITORDER 1
SIGNATURE "GBA ARM7TDMI Multiboot Link/Joybus - RIF"
PADDING 0

@RAW

; Pit 0: 0x000
; Initial ARM branch
; Ignored/overwritten by Multiboot BIOS
[4]

; 0x004..0x09F
; Nintendo logo - 156 fixed bytes
24 FF AE 51 69 9A A2 21 3D 84 82 0A
84 E4 09 AD 11 24 8B 98 C0 81 7F 21
A3 52 BE 19 93 09 CE 20 10 46 4A 4A
F8 27 31 EC 58 C7 E8 33 82 E3 CE BF
85 F4 DF 94 CE 4B 09 C1 94 56 8A C0
13 72 A7 FC 9F 84 4D 73 A3 CA 9A 61
58 97 A3 27 FC 03 98 76 23 1D C7 61
03 04 AE 56 BF 38 84 00 40 A7 0E FD
FF 52 FE 03 6F 95 30 F1 97 FB C0 85
60 D6 80 25 A9 63 BE 03 01 4E 38 E2
F9 A2 34 FF BB 3E 03 44 78 00 90 CB
88 11 3A 94 65 C0 7C 63 87 F0 3C AF
D6 25 E4 8B 38 0A AC 72 21 D4 F8 07

; Pit 1: 0x0A0
; Game title: 12 bytes
; Game code:   4 bytes
[16]

; Pit 2: 0x0B0
; Maker code:        2 bytes
; Fixed value 0x96:  1 byte
; Main unit:         1 byte
; Device type:       1 byte
; Reserved:          7 bytes
; Software version:  1 byte
; Header checksum:   1 byte
; Reserved:          2 bytes
[16]

; Pit 3: 0x0C0
; ARM entry for Normal / Multiplay
; To offset 0xE8: 08 00 00 EA
[4]

; 0x0C4..0x0DF
; Boot mode: 1 byte, overwritten by BIOS
; Slave ID:  1 byte, overwritten by BIOS
; Reserved: 26 bytes
ZERO 28

; Pit 4: 0x0E0
; ARM entry for Joybus
; To offset 0xE8: 00 00 00 EA
[4]

; 0x0E4..0x0E7
; Static padding before ARM code
ZERO 4

@END
