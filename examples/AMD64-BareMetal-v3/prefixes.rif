; Prefix families deliberately exposed by this target profile.

@table membase32
| name | lo | hi |
__
| eax | 0 | 0 |
__
| ecx | 1 | 0 |
__
| edx | 2 | 0 |
__
| ebx | 3 | 0 |
__
| esp | 4 | 0 |
__
| ebp | 5 | 0 |
__
| esi | 6 | 0 |
__
| edi | 7 | 0 |
__
| r8d | 0 | 1 |
__
| r9d | 1 | 1 |
__
| r10d | 2 | 1 |
__
| r11d | 3 | 1 |
__
| r12d | 4 | 1 |
__
| r13d | 5 | 1 |
__
| r14d | 6 | 1 |
__
| r15d | 7 | 1 |
@end

; 0x67 address-size override with the existing 64-bit operand size.
@rule encode_rex_addr32_mem:
. bits 4 4
. bits 1 1
. bits $movdst.hi 1
. bits 0 1
. bits $membase32.hi 1

@rule encode_modrm_addr32_mem:
. bits 2 2
. bits $movdst.lo 3
. bits 4 3
. bits 0 2
. bits 4 3
. bits $membase32.lo 3

@rule load64_67:
. IDENT
. $movdst.name, IDENT
. COMMA
. $membase32.name, IDENT
. COMMA
. bits 103 8
. JUMP encode_rex_addr32_mem
. bits 139 8
. JUMP encode_modrm_addr32_mem
. fit_signed 32

@rule store64_67:
. IDENT
. $movdst.name, IDENT
. COMMA
. $membase32.name, IDENT
. COMMA
. bits 103 8
. JUMP encode_rex_addr32_mem
. bits 137 8
. JUMP encode_modrm_addr32_mem
. fit_signed 32

; LOCK is only declared for read-modify-write memory forms in this profile.
@rule encode_rex_lock_mem:
. bits 4 4
. bits 1 1
. bits $movsrc.hi 1
. bits 0 1
. bits $membase.hi 1

@rule lock_add64:
. IDENT
. $movsrc.name, IDENT
. COMMA
. $membase.name, IDENT
. COMMA
. bits 240 8
. JUMP encode_rex_lock_mem
. bits 1 8
. bits 2 2
. bits $movsrc.lo 3
. bits 4 3
. JUMP encode_sib
. fit_signed 32

@rule lock_inc64:
. IDENT
. $membase.name, IDENT
. COMMA
. bits 240 8
. bits 4 4
. bits 1 1
. bits 0 2
. bits $membase.hi 1
. bits 255 8
. bits 2 2
. bits 0 3
. bits 4 3
. JUMP encode_sib
. fit_signed 32

; REP string forms. The consumer initializes RSI/RDI/RCX as required by the
; selected MIR program; these Rules only declare the emitted bytes.
@rule rep_movsb:
. IDENT
. bits 243 8
. bits 164 8

@rule rep_movsq:
. IDENT
. bits 243 8
. bits 72 8
. bits 165 8

@rule rep_stosb:
. IDENT
. bits 243 8
. bits 170 8

@rule rep_stosq:
. IDENT
. bits 243 8
. bits 72 8
. bits 171 8

; FS and GS segment overrides are explicit prefix families. Other segment
; overrides are intentionally outside this bare-metal profile.
@rule fs_load64:
. IDENT
. $movdst.name, IDENT
. COMMA
. $membase.name, IDENT
. COMMA
. bits 100 8
. JUMP encode_rex_w_mem
. bits 139 8
. JUMP encode_modrm_mem
. fit_signed 32

@rule gs_store64:
. IDENT
. $movdst.name, IDENT
. COMMA
. $membase.name, IDENT
. COMMA
. bits 101 8
. JUMP encode_rex_w_mem
. bits 137 8
. JUMP encode_modrm_mem
. fit_signed 32
