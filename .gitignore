__pycache__/
.rif-cache/
*.py[cod]
.env
/vnma.toml
/skills.md

# --- Artefactos locales de Codex y herramientas de Windows ---
/.codex-attachments/
/_handlecheck/

# --- Salidas binarias generadas por RIF ---
*.pack
*.elf
*.pcic
*.gba
/storage.bin
/windows.pcpi
/datos.store
/labels.json

# El ejemplo GBA necesita gba_header.bin como entrada; el resto son salidas.
/examples/GBA-Bouncing-Ball/main.asm
/examples/GBA-Bouncing-Ball/gba.pack
/examples/GBA-Bouncing-Ball/labels.json
/examples/GBA-Bouncing-Ball/rif_ball*.gba
/examples/GBA-Bouncing-Ball/preview_*.png
/examples/GBA-Bouncing-Ball/preview_*.gif

# Resultados raw y MIR generados por el target AMD64 bare metal.
/examples/AMD64_Baremetal/*.bin
/examples/probe/probe_amd64/*.bin
/examples/probe/probe_amd64/all_encodings.mir
/examples/probe/probe_amd64/negative.mir

# Salidas generadas por el probe AMD64 de sintaxis amigable.
/examples/amd64-friendlysyntaxs/*.bin
/examples/probe/probe_friendlysyntax_qemu/*.bin
!examples/probe/probe_friendlysyntax_qemu/assets/mini_os_iso_header.pcic
!examples/probe/probe_friendlysyntax_qemu/assets/cursor_assets.storage.bin

# MiniOS keeps these two binary checkpoints as intentional example artifacts.
!examples/MiniOsExample/build/mini_os_iso_header.pcic
!examples/MiniOsExample/build/cursor_assets.storage.bin
/examples/MiniOsExample/build/*.iso
/examples/MiniOsExample/build/mini_os_rif_output.bin
/examples/MiniOsExample/build/qemu*.log

# --- VNMA (Vendor Manager) ---
/vendor/
/vendor_vnma/
.vnma_meta/
vnma_cache/
