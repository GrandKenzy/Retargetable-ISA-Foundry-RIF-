; AMD64 bare-metal target with a deliberately friendly input vocabulary.
; The syntax is defined by Rules; RIF core does not know these words.

@block config:
    format section ".section"
    section text "rx"
    section data "rw"
    section bss "rw"
    format section_end ":"
    entry text "_start"
    comment ";"
    format label_end ":"
    default text
    word_size 64
    address_size 64
    byte_order "little"
    case_sensitive true
    symbol_prefix "_"
    local_prefix "."
    undefined_symbols "error"
    duplicate_symbols "error"
    strict true
    allow_empty_sections false
    bit_order "msb"
@end

@block linker:
    extension ".mir"
    search_path ""
@end

@LIBRARY "friendly.riflib"
@LOAD "qemu/framebuffer.rif"
@LOAD "qemu/rules.rif"

@block isa_scope:
    profile "amd64-friendly-base-integer"
    address_size "64-bit-default"
    mmx "excluded"
    sse "excluded"
    avx "excluded"
    avx512 "excluded"
    x87 "excluded"
    system "excluded"
    os_abi "none"
@end

@block framebuffer:
    provider "qemu-std-vga"
    protocol "bochs-vbe"
    mode "linear"
    width 640
    height 480
    bits_per_pixel 32
    pixel_format "BGRX8888"
    io_index 462
    io_data 463
    lfb_source "pci-bar0"
    enable_value 65
    cursor_source_format "RGBA8888"
    cursor_format "BGRX8888"
    cursor_asset "cursor_arrow_bgrx8888"
    cursor_width 14
    cursor_height 22
@end
