; Minimal executable ELF64 target for Linux x86-64.

@block config:
    format section ".section"
    section text "rx"
    section data "rw"
    section bss "rw"
    format section_end ":"
    entry text "_start"
    comment ";"
    format label_end ":"
    default text
    vaddr text 4194304
    word_size 64
    address_size 64
    byte_order "little"
    case_sensitive true
    symbol_prefix "_"
    local_prefix "."
    undefined_symbols "error"
    duplicate_symbols "error"
    strict true
    allow_empty_sections false
    bit_order "msb"
@end

@block linker:
    extension ".asm"
    search_path ""
@end

@table registers
| name | modrm |
__
| rax | 192 |
__
| rcx | 193 |
__
| rdx | 194 |
__
| rbx | 195 |
__
| rsp | 196 |
__
| rbp | 197 |
__
| rsi | 198 |
__
| rdi | 199 |
@end

@rule _start:
. IDENT

@rule mov:
. IDENT
. $registers.name, IDENT
. COMMA
. bits 72 8
. bits 199 8
. bits $registers.modrm 8
. fit 32

@rule syscall:
. IDENT
. bits 15 8
. bits 5 8
