; Legacy high-byte registers cannot be encoded with any REX prefix, so they
; have a separate operand family and separate Rule names.
@table dst8h
| name | lo | movop |
__
| ah | 4 | 180 |
__
| ch | 5 | 181 |
__
| dh | 6 | 182 |
__
| bh | 7 | 183 |
@end
@table src8h
| name | lo |
__
| ah | 4 |
__
| ch | 5 |
__
| dh | 6 |
__
| bh | 7 |
@end

; No-displacement memory has two encodings: normal bases use mod=00, while
; RBP/R13 need mod=01 with an explicit zero disp8. SIB is always emitted by
; the AMD64 profile so RSP/R12 remain unambiguous.
@table membase_nodisp
| name | lo | hi |
__
| rax | 0 | 0 |
__
| rcx | 1 | 0 |
__
| rdx | 2 | 0 |
__
| rbx | 3 | 0 |
__
| rsp | 4 | 0 |
__
| rsi | 6 | 0 |
__
| rdi | 7 | 0 |
__
| r8 | 0 | 1 |
__
| r9 | 1 | 1 |
__
| r10 | 2 | 1 |
__
| r11 | 3 | 1 |
__
| r12 | 4 | 1 |
__
| r14 | 6 | 1 |
__
| r15 | 7 | 1 |
@end
@table membase_zero
| name | lo | hi |
__
| rbp | 5 | 0 |
__
| r13 | 5 | 1 |
@end

