; Low 32-bit GPR operations. Names: eax, ecx, ..., r15d.
; 0x40 prefix intentionally emitted even when no extension is needed.
; Writing a 32-bit register zero-extends the corresponding 64-bit GPR.
@rule encode_rex_32_rr:
. bits 4 4
. bits 0 1
. bits $dst32.hi 1
. bits 0 1
. bits $src32.hi 1

@rule encode_modrm_32_rr:
. bits 3 2
. bits $dst32.lo 3
. bits $src32.lo 3

@rule mov32rr:
. IDENT
. $dst32.name, IDENT
. COMMA
. $src32.name, IDENT
. JUMP encode_rex_32_rr
. bits 139 8
. JUMP encode_modrm_32_rr

@rule add32rr:
. IDENT
. $dst32.name, IDENT
. COMMA
. $src32.name, IDENT
. JUMP encode_rex_32_rr
. bits 3 8
. JUMP encode_modrm_32_rr

@rule sub32rr:
. IDENT
. $dst32.name, IDENT
. COMMA
. $src32.name, IDENT
. JUMP encode_rex_32_rr
. bits 43 8
. JUMP encode_modrm_32_rr

@rule cmp32rr:
. IDENT
. $dst32.name, IDENT
. COMMA
. $src32.name, IDENT
. JUMP encode_rex_32_rr
. bits 59 8
. JUMP encode_modrm_32_rr

@rule xor32rr:
. IDENT
. $dst32.name, IDENT
. COMMA
. $src32.name, IDENT
. JUMP encode_rex_32_rr
. bits 51 8
. JUMP encode_modrm_32_rr

@rule and32rr:
. IDENT
. $dst32.name, IDENT
. COMMA
. $src32.name, IDENT
. JUMP encode_rex_32_rr
. bits 35 8
. JUMP encode_modrm_32_rr

@rule or32rr:
. IDENT
. $dst32.name, IDENT
. COMMA
. $src32.name, IDENT
. JUMP encode_rex_32_rr
. bits 11 8
. JUMP encode_modrm_32_rr

@rule test32rr:
. IDENT
. $dst32.name, IDENT
. COMMA
. $src32.name, IDENT
. JUMP encode_rex_32_rr
. bits 133 8
. JUMP encode_modrm_32_rr

@rule imul32rr:
. IDENT
. $dst32.name, IDENT
. COMMA
. $src32.name, IDENT
. JUMP encode_rex_32_rr
. bits 15 8
. bits 175 8
. JUMP encode_modrm_32_rr

@rule mov32imm:
. IDENT
. $dst32.name, IDENT
. COMMA
. bits 4 4
. bits 0 3
. bits $dst32.hi 1
. bits $dst32.movop 8
. fit 32

; Group-1 imm32 forms use 81 /group imm32.
@rule encode_imm32_32_base:
. bits 4 4
. bits 0 2
. bits 0 1
. bits $dst32.hi 1
. bits 129 8

@rule add32ri:
. IDENT
. $dst32.name, IDENT
. COMMA
. JUMP encode_imm32_32_base
. bits 3 2
. bits 0 3
. bits $dst32.lo 3
. fit 32

@rule or32ri:
. IDENT
. $dst32.name, IDENT
. COMMA
. JUMP encode_imm32_32_base
. bits 3 2
. bits 1 3
. bits $dst32.lo 3
. fit 32

@rule and32ri:
. IDENT
. $dst32.name, IDENT
. COMMA
. JUMP encode_imm32_32_base
. bits 3 2
. bits 4 3
. bits $dst32.lo 3
. fit 32

@rule sub32ri:
. IDENT
. $dst32.name, IDENT
. COMMA
. JUMP encode_imm32_32_base
. bits 3 2
. bits 5 3
. bits $dst32.lo 3
. fit 32

@rule xor32ri:
. IDENT
. $dst32.name, IDENT
. COMMA
. JUMP encode_imm32_32_base
. bits 3 2
. bits 6 3
. bits $dst32.lo 3
. fit 32

@rule cmp32ri:
. IDENT
. $dst32.name, IDENT
. COMMA
. JUMP encode_imm32_32_base
. bits 3 2
. bits 7 3
. bits $dst32.lo 3
. fit 32

; The compact group-1 form sign-extends an imm8 to a 32-bit operand.
@rule encode_imm8_32_base:
. bits 4 4
. bits 0 2
. bits 0 1
. bits $dst32.hi 1
. bits 131 8

@rule add32ri8:
. IDENT
. $dst32.name, IDENT
. COMMA
. JUMP encode_imm8_32_base
. bits 3 2
. bits 0 3
. bits $dst32.lo 3
. fit_signed_exact 8

@rule or32ri8:
. IDENT
. $dst32.name, IDENT
. COMMA
. JUMP encode_imm8_32_base
. bits 3 2
. bits 1 3
. bits $dst32.lo 3
. fit_signed_exact 8

@rule and32ri8:
. IDENT
. $dst32.name, IDENT
. COMMA
. JUMP encode_imm8_32_base
. bits 3 2
. bits 4 3
. bits $dst32.lo 3
. fit_signed_exact 8

@rule sub32ri8:
. IDENT
. $dst32.name, IDENT
. COMMA
. JUMP encode_imm8_32_base
. bits 3 2
. bits 5 3
. bits $dst32.lo 3
. fit_signed_exact 8

@rule xor32ri8:
. IDENT
. $dst32.name, IDENT
. COMMA
. JUMP encode_imm8_32_base
. bits 3 2
. bits 6 3
. bits $dst32.lo 3
. fit_signed_exact 8

@rule cmp32ri8:
. IDENT
. $dst32.name, IDENT
. COMMA
. JUMP encode_imm8_32_base
. bits 3 2
. bits 7 3
. bits $dst32.lo 3
. fit_signed_exact 8
