; Low 32-bit GPR operations. Names: eax, ecx, ..., r15d.
; 0x40 prefix intentionally emitted even when no extension is needed.
; Writing a 32-bit register zero-extends the corresponding 64-bit GPR.
@rule encode_rex_32_rr:
. bits 4 4
. bits 0 1
. bits $dst32.hi 1
. bits 0 1
. bits $src32.hi 1

@rule encode_modrm_32_rr:
. bits 3 2
. bits $dst32.lo 3
. bits $src32.lo 3

@rule mov32rr:
. IDENT
. $dst32.name, IDENT
. COMMA
. $src32.name, IDENT
. JUMP encode_rex_32_rr
. bits 139 8
. JUMP encode_modrm_32_rr

@rule add32rr:
. IDENT
. $dst32.name, IDENT
. COMMA
. $src32.name, IDENT
. JUMP encode_rex_32_rr
. bits 3 8
. JUMP encode_modrm_32_rr

@rule sub32rr:
. IDENT
. $dst32.name, IDENT
. COMMA
. $src32.name, IDENT
. JUMP encode_rex_32_rr
. bits 43 8
. JUMP encode_modrm_32_rr

@rule cmp32rr:
. IDENT
. $dst32.name, IDENT
. COMMA
. $src32.name, IDENT
. JUMP encode_rex_32_rr
. bits 59 8
. JUMP encode_modrm_32_rr

@rule xor32rr:
. IDENT
. $dst32.name, IDENT
. COMMA
. $src32.name, IDENT
. JUMP encode_rex_32_rr
. bits 51 8
. JUMP encode_modrm_32_rr

@rule mov32imm:
. IDENT
. $dst32.name, IDENT
. COMMA
. bits 4 4
. bits 0 3
. bits $dst32.hi 1
. bits $dst32.movop 8
. fit 32
