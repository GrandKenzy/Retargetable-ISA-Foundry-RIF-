; Syntax is explicit r64,r64, destination first; REG is destination.
; All operations share REX and ModRM; opcode varies.
@rule movrr:
. IDENT
. $movdst.name, IDENT
. COMMA
. $movsrc.name, IDENT
. JUMP encode_rex_w_rr
. bits 139 8
. JUMP encode_modrm_rr

@rule addrr:
. IDENT
. $movdst.name, IDENT
. COMMA
. $movsrc.name, IDENT
. JUMP encode_rex_w_rr
. bits 3 8
. JUMP encode_modrm_rr

@rule subrr:
. IDENT
. $movdst.name, IDENT
. COMMA
. $movsrc.name, IDENT
. JUMP encode_rex_w_rr
. bits 43 8
. JUMP encode_modrm_rr

@rule cmprr:
. IDENT
. $movdst.name, IDENT
. COMMA
. $movsrc.name, IDENT
. JUMP encode_rex_w_rr
. bits 59 8
. JUMP encode_modrm_rr

@rule xorrr:
. IDENT
. $movdst.name, IDENT
. COMMA
. $movsrc.name, IDENT
. JUMP encode_rex_w_rr
. bits 51 8
. JUMP encode_modrm_rr

@rule andrr:
. IDENT
. $movdst.name, IDENT
. COMMA
. $movsrc.name, IDENT
. JUMP encode_rex_w_rr
. bits 35 8
. JUMP encode_modrm_rr

@rule orrr:
. IDENT
. $movdst.name, IDENT
. COMMA
. $movsrc.name, IDENT
. JUMP encode_rex_w_rr
. bits 11 8
. JUMP encode_modrm_rr

@rule testrr:
. IDENT
. $movdst.name, IDENT
. COMMA
. $movsrc.name, IDENT
. JUMP encode_rex_w_rr
. bits 133 8
. JUMP encode_modrm_rr

@rule imulrr:
. IDENT
. $movdst.name, IDENT
. COMMA
. $movsrc.name, IDENT
. JUMP encode_rex_w_rr
. bits 15 8
. bits 175 8
. JUMP encode_modrm_rr

; 64-bit immediate groups: REX.W 81 /extension imm32 (sign-extended).
@rule encode_imm32_base:
. bits 4 4
. bits 1 1
. bits 0 2
. bits $movdst.hi 1
. bits 129 8

@rule addri:
. IDENT
. $movdst.name, IDENT
. COMMA
. JUMP encode_imm32_base
. bits 3 2
. bits 0 3
. bits $movdst.lo 3
. fit 32

@rule orri:
. IDENT
. $movdst.name, IDENT
. COMMA
. JUMP encode_imm32_base
. bits 3 2
. bits 1 3
. bits $movdst.lo 3
. fit 32

@rule andri:
. IDENT
. $movdst.name, IDENT
. COMMA
. JUMP encode_imm32_base
. bits 3 2
. bits 4 3
. bits $movdst.lo 3
. fit 32

@rule subri:
. IDENT
. $movdst.name, IDENT
. COMMA
. JUMP encode_imm32_base
. bits 3 2
. bits 5 3
. bits $movdst.lo 3
. fit 32

@rule xorri:
. IDENT
. $movdst.name, IDENT
. COMMA
. JUMP encode_imm32_base
. bits 3 2
. bits 6 3
. bits $movdst.lo 3
. fit 32

@rule cmpri:
. IDENT
. $movdst.name, IDENT
. COMMA
. JUMP encode_imm32_base
. bits 3 2
. bits 7 3
. bits $movdst.lo 3
. fit 32

; 64-bit group-2 shifts by imm8; shift count is masked by the CPU.
@rule encode_shift_base:
. bits 4 4
. bits 1 1
. bits 0 2
. bits $movdst.hi 1
. bits 193 8

@rule shlri:
. IDENT
. $movdst.name, IDENT
. COMMA
. JUMP encode_shift_base
. bits 3 2
. bits 4 3
. bits $movdst.lo 3
. fit 8

@rule shrri:
. IDENT
. $movdst.name, IDENT
. COMMA
. JUMP encode_shift_base
. bits 3 2
. bits 5 3
. bits $movdst.lo 3
. fit 8

@rule sarri:
. IDENT
. $movdst.name, IDENT
. COMMA
. JUMP encode_shift_base
. bits 3 2
. bits 7 3
. bits $movdst.lo 3
. fit 8
