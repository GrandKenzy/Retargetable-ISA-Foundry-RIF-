; All 16 x86 condition codes driven by one table.
; jcc32 cc, rel32: explicit displacement, not a label fixup.
@rule jcc32:
. IDENT
. $conditions.name, IDENT
. COMMA
. bits 15 8
. bits $conditions.jopcode 8
. fit 32

; cmovrr cc, dst64, src64. x86 flags from prior operations.
@rule cmovrr:
. IDENT
. $conditions.name, IDENT
. COMMA
. $movdst.name, IDENT
. COMMA
. $movsrc.name, IDENT
. JUMP encode_rex_w_rr
. bits 15 8
. bits $conditions.cmovop 8
. JUMP encode_modrm_rr

; setcc cc, dst64: writes the LOW 8 BITS of the specified GPR.
; Always emit REX=40/41 to make SPL/BPL/SIL/DIL addressable.
@rule setcc:
. IDENT
. $conditions.name, IDENT
. COMMA
. $movdst.name, IDENT
. bits 4 4
. bits 0 3
. bits $movdst.hi 1
. bits 15 8
. bits $conditions.setop 8
. bits 3 2
. bits 0 3
. bits $movdst.lo 3
