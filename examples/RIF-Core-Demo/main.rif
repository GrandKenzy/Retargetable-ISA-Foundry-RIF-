; Proyecto demostrativo de RIF

@block config:
    format section ".section"
    section data "rw"
    section text "rx"
    section bss "rw"
    format section_end ":"
    entry text "_start"
    comment ";"
    format label_end ":"
    default text
    align text 4
    align data 4
    align bss 4
    word_size 32
    address_size 32
    byte_order "little"
    case_sensitive true
    symbol_prefix "_"
    local_prefix "."
    undefined_symbols "error"
    duplicate_symbols "error"
    strict true
    allow_empty_sections false
@end

@block linker:
    extension ".asm"
    search_path ""
@end

@stack 50

@table registers
| name | opcode | bits | value |
________________________________________
| mov | 1 | "00000000" | 42 |
________________________________________
| add | 2 | "00000001" | 7 |
________________________________________
| ret | 3 | "00000010" | 0 |
@end

@define mov
@define add
@define ret

@rule mov:
. $registers.opcode, IDENT
. KW "mov"
. IDENT
. [NUMBER, STRING]
. nibbles 0000 $registers.bits
. nibbles &buffer 0000
. emit 0 0 0 0 0 0 0 0
. emit $registers.bits 0 0 0 0 0 0 0
. eword 83847483
. eword $registers.value
. JUMPIF add, true
. save "current"
. load "current"
. reserve "buffer" 16
. write_res "buffer" $registers.value
. write_res "buffer" &buffer
. emit_res "buffer"
. drop_res "buffer"
. frame 0000 $registers.bits 0
0
&buffer
00000000
0000
0
0000
0000000
0000
. frameend
. JUMP add
. BREAK
@rule add:
. $registers.opcode, NUMBER
. KW "add"
. nibbles 0000 0000
. ERROR, "No se pudo resolver add"
. BREAK
@rule ret:
. KW "ret"
. eword 83847483
. BREAK
